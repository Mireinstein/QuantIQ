# Paper trading keys, free from
# https://app.alpaca.markets/paper/dashboard/overview -- open the API Keys
# panel and generate one. Copy this file to .env and fill in the two blanks.
#
# Anything already exported wins over this file.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# The venue refuses to start against anything but the paper endpoint.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
